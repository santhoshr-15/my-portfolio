---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | Cyber Portfolio">
  <div class="min-h-[80vh] flex items-center justify-center px-4">
    
    <div class="w-full max-w-4xl grid md:grid-cols-2 gap-0 rounded-3xl overflow-hidden border border-white/10 bg-[#111] shadow-2xl">
        
        {/* Left: Info Side */}
        <div class="p-10 flex flex-col justify-between bg-gradient-to-br from-indigo-900/50 to-purple-900/50 relative overflow-hidden">
            <div class="absolute inset-0 bg-[url('https://grainy-gradients.vercel.app/noise.svg')] opacity-20"></div>
            
            <div class="relative z-10">
                <h1 class="text-4xl font-bold text-white mb-4">Let's Talk.</h1>
                <p class="text-indigo-200">
                    Have a project in mind or want to discuss security? Send an encrypted signal.
                </p>
            </div>

            <div class="space-y-4 relative z-10 mt-10">
                <div class="flex items-center gap-4 text-gray-300">
                    <span class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center">📧</span>
                    <span>hello@cyberportfolio.com</span>
                </div>
                <div class="flex items-center gap-4 text-gray-300">
                    <span class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center">📍</span>
                    <span>Chennai, India</span>
                </div>
            </div>
        </div>

        {/* Right: The Form */}
        <div class="p-10 bg-[#0a0a0a]">
            <form class="space-y-6">
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-2">Identify Yourself</label>
                    <input type="text" placeholder="Name or Handle" class="w-full bg-[#1a1a1a] border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-indigo-500 transition-colors" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-2">Frequency (Email)</label>
                    <input type="email" placeholder="you@example.com" class="w-full bg-[#1a1a1a] border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-indigo-500 transition-colors" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-2">Transmission</label>
                    <textarea rows="4" placeholder="Your message..." class="w-full bg-[#1a1a1a] border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-indigo-500 transition-colors"></textarea>
                </div>

                <button class="w-full py-4 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-bold transition-all shadow-[0_0_20px_rgba(79,70,229,0.3)]">
                    Send Transmission
                </button>
            </form>
        </div>

    </div>

  </div>
</Layout>