---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | Cyber Portfolio">
  <div class="min-h-screen flex items-center justify-center px-4 py-24">
    
    {/* Main Card Container */}
    <div class="w-full max-w-5xl grid md:grid-cols-2 gap-0 rounded-3xl overflow-hidden border border-white/10 bg-[#0a0a0a] shadow-2xl relative group">
        
        {/* GLOW BORDER EFFECT */}
        <div class="absolute inset-0 bg-gradient-to-r from-indigo-500/20 to-purple-500/20 opacity-0 group-hover:opacity-100 transition duration-500 pointer-events-none mix-blend-overlay"></div>

        {/* LEFT: INFO TERMINAL */}
        <div class="p-10 md:p-12 flex flex-col justify-between bg-[#0f0f0f] relative overflow-hidden border-r border-white/5">
            
            {/* Cyber Grid Background */}
            <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-[size:40px_40px] opacity-50"></div>
            
            {/* Status Indicator */}
            <div class="relative z-10 flex items-center gap-2 mb-8">
                <span class="relative flex h-3 w-3">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
                </span>
                <span class="text-xs font-mono text-green-400 font-bold tracking-widest uppercase">System Online</span>
            </div>

            <div class="relative z-10">
                <h3 class="text-3xl font-bold text-white mb-4">Contact Info</h3>
                <p class="text-gray-400 text-lg leading-relaxed mb-8">
                    Currently available for freelance security audits, full-stack development, and consultation.
                </p>

                {/* Info Items */}
                <div class="space-y-6">
                    <div class="flex items-center gap-4 group/item">
                        <div class="w-12 h-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-xl group-hover/item:border-indigo-500/50 group-hover/item:text-indigo-400 transition-colors">
                            📧
                        </div>
                        <div>
                            <p class="text-[10px] text-gray-500 font-bold uppercase tracking-wider">Email Frequency</p>
                            <p class="text-white font-medium">hello@cyberportfolio.com</p>
                        </div>
                    </div>
                    
                    <div class="flex items-center gap-4 group/item">
                        <div class="w-12 h-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-xl group-hover/item:border-indigo-500/50 group-hover/item:text-indigo-400 transition-colors">
                            📍
                        </div>
                        <div>
                            <p class="text-[10px] text-gray-500 font-bold uppercase tracking-wider">Base of Operations</p>
                            <p class="text-white font-medium">Chennai, India</p>
                        </div>
                    </div>

                    <div class="flex items-center gap-4 group/item">
                         <div class="w-12 h-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-xl group-hover/item:border-indigo-500/50 group-hover/item:text-indigo-400 transition-colors">
                            🔗
                        </div>
                        <div>
                            <p class="text-[10px] text-gray-500 font-bold uppercase tracking-wider">Secure Channels</p>
                            <div class="flex gap-3 text-sm font-medium text-white">
                                <a href="#" class="hover:text-indigo-400 transition">LinkedIn</a>
                                <span class="text-gray-600">/</span>
                                <a href="#" class="hover:text-indigo-400 transition">GitHub</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {/* RIGHT: TRANSMISSION FORM */}
        <div class="p-10 md:p-12 bg-[#0a0a0a] relative">
            <form class="space-y-6 relative z-10">
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-2 ml-1">Identify Yourself</label>
                    <input type="text" placeholder="Name or Handle" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-4 text-white placeholder-gray-600 focus:outline-none focus:border-indigo-500 focus:bg-white/10 transition-all" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-2 ml-1">Return Address (Email)</label>
                    <input type="email" placeholder="you@example.com" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-4 text-white placeholder-gray-600 focus:outline-none focus:border-indigo-500 focus:bg-white/10 transition-all" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-2 ml-1">Transmission Message</label>
                    <textarea rows="4" placeholder="Enter your message..." class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-4 text-white placeholder-gray-600 focus:outline-none focus:border-indigo-500 focus:bg-white/10 transition-all resize-none"></textarea>
                </div>

                <button class="w-full py-4 rounded-xl bg-indigo-600 font-bold text-white transition-all duration-300 hover:bg-indigo-500 hover:shadow-[0_0_30px_rgba(79,70,229,0.4)] relative overflow-hidden group">
                    <span class="relative z-10">Send Transmission</span>
                    <div class="absolute inset-0 bg-gradient-to-r from-indigo-600 to-purple-600 opacity-0 group-hover:opacity-100 transition duration-300"></div>
                </button>
            </form>
        </div>

    </div>

  </div>
</Layout>