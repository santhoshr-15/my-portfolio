---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import Navbar from '../components/Navbar.jsx';

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Cybersecurity Portfolio" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ViewTransitions /> </head>
	<body class="bg-[#0a0a0a] text-white font-sans min-h-screen selection:bg-indigo-500 selection:text-white pb-24">
		
		<div class="fixed inset-0 -z-10 h-full w-full bg-[#0a0a0a]">
			<div class="absolute bottom-0 left-[-20%] right-0 top-[-10%] h-[500px] w-[500px] rounded-full bg-[radial-gradient(circle_farthest-side,rgba(76,29,149,0.15),rgba(255,255,255,0))]"></div>
			<div class="absolute bottom-0 right-[-20%] top-[-10%] h-[500px] w-[500px] rounded-full bg-[radial-gradient(circle_farthest-side,rgba(255,0,182,0.15),rgba(255,255,255,0))]"></div>
		</div>

		<slot />

		<div class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50">
			<Navbar client:load />
		</div>

	</body>
</html>