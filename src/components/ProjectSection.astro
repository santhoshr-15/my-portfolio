---
const projects = [
  {
    title: "Security Scanner AI",
    desc: "A Python-based vulnerability scanner using Deep Learning to detect 0-day threats.",
    tags: ["Python", "TensorFlow", "CyberSec"],
    color: "from-purple-600 to-blue-600",
    icon: "🛡️"
  },
  {
    title: "Zero Trust Auth",
    desc: "Implemented OIDC and secure authentication flows in Rust. Ensures no user is trusted by default.",
    tags: ["Rust", "WASM", "Auth0"],
    color: "from-orange-500 to-red-600",
    icon: "🔒"
  },
  {
    title: "Phishing Hunter",
    desc: "Real-time browser extension that analyzes URL patterns to block phishing sites instantly.",
    tags: ["JavaScript", "Manifest V3", "API"],
    color: "from-emerald-500 to-green-600",
    icon: "🎣"
  },
  {
    title: "Encrypted Chat",
    desc: "End-to-End encrypted messaging platform using Socket.io and AES-256 encryption.",
    tags: ["Node.js", "React", "Socket.io"],
    color: "from-pink-500 to-rose-600",
    icon: "💬"
  }
];
---

<section class="w-full max-w-7xl mx-auto px-4 py-32 relative z-10 border-t border-white/10 mt-20">
    
    {/* 1. SECTION HEADER */}
    <div class="text-center mb-20">
        <h2 class="text-sm font-bold tracking-widest text-indigo-500 uppercase mb-3">System Logs</h2>
        <h1 class="text-4xl md:text-5xl font-bold text-white">
            Deployed <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-cyan-400">Missions</span>
        </h1>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto mt-4">
            A collection of deployed systems, security research, and open source contributions.
        </p>
    </div>

    {/* 2. THE PROJECTS GRID */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto">
      {projects.map((p) => (
        <div class="group relative rounded-3xl bg-[#111] border border-white/10 overflow-hidden hover:border-white/20 transition-all hover:-translate-y-2 duration-300">
            
            {/* Top Glow Line */}
            <div class={`absolute top-0 left-0 w-full h-1 bg-gradient-to-r ${p.color}`}></div>
            
            {/* Ambient Background Glow */}
            <div class={`absolute -right-20 -top-20 w-64 h-64 bg-gradient-to-br ${p.color} opacity-5 blur-[80px] group-hover:opacity-15 transition duration-500`}></div>

            <div class="p-8 relative z-10">
                <div class="flex justify-between items-start mb-6">
                    <div class={`w-14 h-14 rounded-2xl bg-gradient-to-br ${p.color} flex items-center justify-center text-3xl shadow-lg`}>
                        {p.icon}
                    </div>
                    {/* Year Badge */}
                    <span class="px-3 py-1 rounded-full bg-white/5 text-xs text-gray-500 font-bold border border-white/5 uppercase tracking-wider group-hover:bg-white/10 transition">
                        2025
                    </span>
                </div>

                <h3 class="text-3xl font-bold text-white mb-3 group-hover:text-indigo-200 transition-colors">{p.title}</h3>
                <p class="text-gray-400 mb-8 leading-relaxed text-lg">{p.desc}</p>

                <div class="flex gap-2 flex-wrap">
                    {p.tags.map(tag => (
                        <span class="px-3 py-1 rounded-md bg-[#1a1a1a] text-gray-300 text-sm font-bold border border-white/5 group-hover:border-white/10 transition">
                            #{tag}
                        </span>
                    ))}
                </div>
            </div>
        </div>
      ))}
    </div>
</section>