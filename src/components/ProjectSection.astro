---
import ProjectGrid from './ProjectGrid.jsx'
---

<section class="w-full max-w-7xl mx-auto px-4 py-32 relative z-10 border-t border-white/10 mt-20">

  <!-- SECTION HEADER -->
  <div class="text-center mb-20">
    <h2 class="text-sm font-bold tracking-widest text-indigo-500 uppercase mb-3">
      System Logs
    </h2>
    <h1 class="text-4xl md:text-5xl font-bold text-white">
      Deployed 
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-cyan-400">
        Projects
      </span>
    </h1>
    <p class="text-xl text-gray-400 max-w-2xl mx-auto mt-4">
      A collection of deployed systems, security research, and open source contributions.
    </p>
  </div>

  <!-- REACT GRID -->
  <ProjectGrid client:visible />

</section>
