---
const certs = [
  {
    title: "Certified Ethical Hacker (CEH)",
    issuer: "EC-Council",
    date: "2024",
    id: "ECC-123456789",
    color: "border-red-500",
    glow: "shadow-[0_0_30px_rgba(239,68,68,0.15)]", // Softer glow
    icon: "🛡️"
  },
  {
    title: "CompTIA Security+",
    issuer: "CompTIA",
    date: "2023",
    id: "COMP-987654321",
    color: "border-blue-500",
    glow: "shadow-[0_0_30px_rgba(59,130,246,0.15)]",
    icon: "🔐"
  },
  {
    title: "Google Cybersecurity Professional",
    issuer: "Google",
    date: "2023",
    id: "GOOG-555666777",
    color: "border-yellow-500",
    glow: "shadow-[0_0_30px_rgba(234,179,8,0.15)]",
    icon: "📜"
  },
  {
    title: "AWS Certified Security - Specialty",
    issuer: "Amazon Web Services",
    date: "2025",
    id: "AWS-11223344",
    color: "border-orange-500",
    glow: "shadow-[0_0_30px_rgba(249,115,22,0.15)]",
    icon: "☁️"
  }
];
---

<section class="w-full max-w-7xl mx-auto px-4 py-32 relative z-10 border-t border-white/10 mt-20">
    
    {/* 1. HEADER */}
    <div class="text-center mb-20">
        <h2 class="text-sm font-bold tracking-widest text-indigo-500 uppercase mb-3">Credentials</h2>
        <h1 class="text-4xl md:text-5xl font-bold text-white">
            Verified <span class="text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-500">Certifications</span>
        </h1>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto mt-4">
            Industry-recognized qualifications validating my expertise in security architecture and ethical hacking.
        </p>
    </div>

    {/* 2. CERTIFICATION GRID */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
      {certs.map((cert) => (
        // REMOVED: hover:-translate-y-1 (Now it is stable)
        // ADDED: hover:border-white/30 and transition-all duration-500 (Smooth Glow)
        <div class={`relative p-6 rounded-2xl bg-[#0a0a0a] border border-white/10 hover:border-white/40 transition-all duration-500 group ${cert.glow}`}>
            
            {/* Top Badge Decoration */}
            <div class="absolute -top-3 -right-3 w-8 h-8 rounded-full bg-[#111] border border-white/20 flex items-center justify-center shadow-xl z-10">
                <span class="text-green-500 text-sm">✓</span>
            </div>

            {/* Content */}
            <div class="flex flex-col h-full justify-between relative z-0">
                <div>
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-10 h-10 rounded-lg bg-white/5 flex items-center justify-center text-xl">
                            {cert.icon}
                        </div>
                        <div class="text-xs font-bold text-gray-500 uppercase tracking-wider border border-white/10 px-2 py-1 rounded">
                            {cert.date}
                        </div>
                    </div>

                    <h3 class="text-lg font-bold text-white leading-tight mb-2 group-hover:text-indigo-300 transition-colors">
                        {cert.title}
                    </h3>
                    <p class="text-sm text-gray-400">{cert.issuer}</p>
                </div>
                
                {/* ID Number */}
                <div class="mt-6 pt-4 border-t border-white/5 flex justify-between items-center">
                    <span class="text-[10px] text-gray-600 font-mono uppercase">ID: {cert.id}</span>
                    <span class={`w-2 h-2 rounded-full ${cert.color.replace('border', 'bg')}`}></span>
                </div>
            </div>
        </div>
      ))}
    </div>

</section>