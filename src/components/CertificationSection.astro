---
import CertificationGrid from './CertificationGrid.jsx';
---

<section class="w-full max-w-7xl mx-auto px-4 py-32 relative z-10 border-t border-white/10 mt-20">
    
    {/* 1. HEADER */}
    <div class="text-center mb-20">
        <h2 class="text-sm font-bold tracking-widest text-indigo-500 uppercase mb-3">Credentials</h2>
        <h1 class="text-4xl md:text-5xl font-bold text-white">
            Verified <span class="text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-500">Certifications</span>
        </h1>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto mt-4">
            Industry-recognized qualifications validating my expertise in security architecture and ethical hacking.
        </p>
    </div>

    {/* 2. THE ANIMATED GRID */}
    {/* This loads the CertificationGrid.jsx you created, enabling the Smooth Flow animation */}
    <CertificationGrid client:visible />

</section>